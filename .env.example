# Copy this file to .env and fill in real values for local development.
# In production (Railway/Render), set these as actual environment variables
# in the hosting dashboard — never commit real secrets to git.

# PostgreSQL connection (use your Neon connection string in production)
DATABASE_URL=jdbc:postgresql://localhost:5432/dynashuttle
DATABASE_USER=postgres
DATABASE_PASSWORD=Shivam@12345

# JWT signing secret — generate a long random string for production
JWT_SECRET=dev-secret-change-me

# Google Maps API key (used by the Android apps for map display/navigation —
# NOT used by the backend anymore; backend ETA routing uses TomTom, below)
GOOGLE_MAPS_API_KEY=

# TomTom Routing API key — real traffic-aware ETA (master plan Section 5, item 9)
# Get one at https://developer.tomtom.com (free tier, no credit card required).
# If left blank, the backend falls back to a flat-speed ETA estimate instead of
# crashing — see EtaEstimator / Routing.kt.
TOMTOM_API_KEY=

# Brevo transactional email API key — real OTP delivery (master plan Section 5,
# item 11). Get one at https://app.brevo.com (free tier: 300 emails/day, no
# credit card required). Chosen over SMS because DLT registration (India's
# mandatory SMS compliance registry) requires a registered business entity,
# which DynaShuttle doesn't have yet — email needs no such registration, ever.
BREVO_API_KEY=

# The "from" address for OTP emails. IMPORTANT: this exact email/domain must be
# verified as a sender in your Brevo account dashboard first — Brevo will
# reject every send from an unverified sender, even with a valid API key.
# See: https://developers.brevo.com/docs/send-a-transactional-email
BREVO_SENDER_EMAIL=

# If either Brevo variable above is left blank, the backend falls back to
# dev-mode OTP delivery — the code is returned directly in the API response
# instead of being emailed, exactly like today. See NoOpOtpSender / Routing.kt.

# Firebase service account credentials path (for push notifications)
FIREBASE_CREDENTIALS_PATH=

# Server port (Railway/Render set this automatically; defaults to 8080 locally)
PORT=8080
