# Copy this file to .env and fill in real values for local development.
# In production (Railway/Render), set these as actual environment variables
# in the hosting dashboard — never commit real secrets to git.

# PostgreSQL connection (use your Neon connection string in production)
DATABASE_URL=jdbc:postgresql://localhost:5432/dynashuttle
DATABASE_USER=postgres
DATABASE_PASSWORD=Shivam@12345

# JWT signing secret — generate a long random string for production
JWT_SECRET=dev-secret-change-me

# Google Maps API key (Routes API + Distance Matrix)
GOOGLE_MAPS_API_KEY=

# Firebase service account credentials path (for push notifications)
FIREBASE_CREDENTIALS_PATH=

# Server port (Railway/Render set this automatically; defaults to 8080 locally)
PORT=8080
